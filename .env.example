# Copy to .env and fill in. Docker Compose reads .env automatically.

# Get one for free at https://app.localstack.cloud (Auth Tokens page).
LOCALSTACK_AUTH_TOKEN=

# Image tag. 2026.x images need the token above; the legacy 4.14 community
# image runs without one but no longer gets updates.
LOCALSTACK_VERSION=2026.10.0

AWS_DEFAULT_REGION=eu-central-1

# Set to 1 for verbose LocalStack logs.
DEBUG=0
